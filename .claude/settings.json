{
  "permissions": {
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(make up:*)",
      "Bash(make down:*)",
      "Bash(aws ec2 run-instances:*)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.ovpn)",
      "Read(./**/*.key)",
      "Read(./.env)"
    ],
    "ask": [
      "Bash(terraform plan:*)",
      "Bash(ansible-playbook:*)",
      "Bash(aws:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-lessons.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
